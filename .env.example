# ─── Frontend (Vite) ───────────────────────────────────────────────────────────
# URL of the Express API server (leave empty to use /api on same origin)
VITE_API_URL=http://localhost:4000

# ─── Backend (Express) ─────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# Gmail credentials for Nodemailer (use App Password, not your account password)
# Guide: https://support.google.com/accounts/answer/185833
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-16-char-app-password

# Destination inbox for contact form submissions
EMAIL_TO=priyanautiyal978@gmail.com

# Allowed frontend origin for CORS
FRONTEND_URL=http://localhost:5173
